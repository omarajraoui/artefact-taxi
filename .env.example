# Copy to .env (`cp .env.example .env`) before `docker compose up`.

# --- Object storage (SeaweedFS, S3-compatible) ---
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=datalake-admin
S3_SECRET_KEY=datalake-secret-123
S3_BUCKET=datalake

# --- Source: Chicago Taxi Trips (SODA API) ---
SODA_DATASET_URL=https://data.cityofchicago.org/resource/wrvz-psew.csv
# Optional Socrata app token (higher rate limits): https://data.cityofchicago.org/profile/edit/developer_settings
SODA_APP_TOKEN=
# Half-open period [TRIPS_START, TRIPS_END): Q1 2023 = 1,446,439 trips (SODA count, 29 Oct 2026).
TRIPS_START=2023-01-01
TRIPS_END=2023-04-01
SODA_PAGE_SIZE=50000
# Optional cap per month for a quick demo (empty = everything).
MAX_ROWS_PER_MONTH=

# --- Data quality ---
# The silver job fails if more than this share of rows is rejected.
MAX_REJECT_RATE=0.2

# --- Spark ---
SPARK_DRIVER_MEMORY=2g
# Memory cap of the scheduler container, where Spark runs (keep it above SPARK_DRIVER_MEMORY + ~1 GB for Airflow).
SCHEDULER_MEM_LIMIT=3g

# --- Airflow UI ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
